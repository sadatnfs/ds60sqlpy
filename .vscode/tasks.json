{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Course: Docker classroom",
      "type": "process",
      "command": "bash",
      "args": ["scripts/classroom.sh"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Course: Contributor classroom",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/course.py", "serve"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Course: Contributor setup (POSIX / WSL)",
      "type": "shell",
      "command": "bash scripts/setup.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Course: Doctor",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/course.py", "doctor"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Course: Catalog",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/course.py", "catalog"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Course: Validate",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["scripts/course.py", "validate"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Course: JupyterLab",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "jupyterlab", "python/ds-60day/notebooks"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Course: PostgreSQL Notebook",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "jupyterlab", "bridge/professional/notebooks"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Course: Bridge tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "bridge/tests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Course: Professional tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "python/professional/tests", "bridge/professional/tests"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
