ARG DS60_SPARK_IMAGE=spark:4.0.1-scala2.13-java17-python3-ubuntu
ARG DS60_PYTHON_IMAGE=python:3.12.12-slim-bookworm
FROM ${DS60_SPARK_IMAGE} AS spark
FROM ${DS60_PYTHON_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*
COPY --from=spark /opt/spark /opt/spark
RUN install -d -m 0700 /run/ds60
WORKDIR /opt/worker
COPY src/ds60sqlpy/__init__.py src/ds60sqlpy/http_server.py src/ds60sqlpy/module_worker.py src/ds60sqlpy/worker_operations.py src/ds60sqlpy/plot_artifacts.py src/ds60sqlpy/plot_capture.py src/ds60sqlpy/worker_figures.py /opt/worker/src/ds60sqlpy/
COPY courses/scala-spark/fixtures/ /opt/worker/courses/scala-spark/fixtures/
ENV SPARK_HOME=/opt/spark PYTHONPATH=/opt/worker/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DS60_WORKER_PROFILE=scala-jvm SPARK_LOCAL_IP=127.0.0.1
ENTRYPOINT ["python", "-m", "ds60sqlpy.module_worker", "--host", "0.0.0.0", "--port", "8081"]
