// dax-035: Fiscal labels, boundaries and as-of totals
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-035-a: Two neighboring fiscal labels
// Context: The declared fiscal year starts July 1 and is named by its ending year.
EVALUATE SELECTCOLUMNS ( FILTER ( 'Date', 'Date'[Date] IN { DATE ( 2024, 6, 30 ), DATE ( 2024, 7, 1 ) } ), "Day", 'Date'[Date], "FiscalYear", 'Date'[FiscalYear] )
ORDER BY [Day]

// dax-035-b: Available fiscal-year-to-date revenue
// Context: FY 2025 under the July-start convention, observed only through 2025-02-28; active OrderDate.
EVALUATE CALCULATETABLE ( ROW ( "FiscalYTDRevenue", [NetRevenue] ), 'Date'[FiscalYear] = 2025, 'Date'[Date] <= DATE ( 2025, 2, 28 ) )
