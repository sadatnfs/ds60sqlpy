// dax-012: VAR and RETURN: values are not context-sensitive macros
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-012-a: Binding before a new filter
// Context: Start unfiltered; bind the variable before introducing Blue.
EVALUATE
VAR RevenueBeforeColorChange = [NetRevenue]
RETURN ROW ( "FrozenInBlue", CALCULATE ( RevenueBeforeColorChange, Product[Color] = "Blue" ), "RecomputedInBlue", CALCULATE ( [NetRevenue], Product[Color] = "Blue" ) )

// dax-012-b: Binding inside Blue before removing it
// Context: The outer CALCULATETABLE supplies Blue before the variable is bound.
EVALUATE CALCULATETABLE (
    VAR RevenueBeforeRemoval = [NetRevenue]
    RETURN ROW ( "FrozenWithoutColor", CALCULATE ( RevenueBeforeRemoval, REMOVEFILTERS ( Product[Color] ) ), "RecomputedWithoutColor", CALCULATE ( [NetRevenue], REMOVEFILTERS ( Product[Color] ) ) ),
    Product[Color] = "Blue"
)
