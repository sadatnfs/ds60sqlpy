#!/usr/bin/env bash
# Use the shared pinned Docker toolchain for read-only source lint checks.
set -euo pipefail
for arg in "$@"; do
  case "$arg" in
    -h | --help)
      cat <<'HELP'
Usage: ./scripts/lint-repo [--build] [--list] [--language NAME]

Run read-only static and syntax checks with the pinned Docker toolchain.
--build       Rebuild the shared tool image with visible Docker build logs.
--list        Print source coverage and preservation reasons without linting.
--language    Select one language (repeatable); omit for all supported checks.

Requires a local Linux Docker engine. Windows users run inside WSL 2.
This command does not change source files, run lessons or modify learner state.
Static and syntax checks supplement compilation, tests and runtime verification.
HELP
      exit 0
      ;;
  esac
done
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
exec "$script_dir/format-repo" --lint "$@"
