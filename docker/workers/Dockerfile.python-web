ARG DS60_PYTHON_IMAGE=python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
FROM ${DS60_PYTHON_IMAGE}
# Apply Debian security updates newer than the pinned base image.
# hadolint ignore=DL3005
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
COPY requirements/bootstrap-pip.lock /tmp/bootstrap-pip.lock
# Optional anonymous mirror for restricted networks; locked hashes are still required.
ARG DS60_PYTHON_INDEX_URL
# The venv has no pip of its own; the upgraded base pip installs into it and
# both are removed once the locked install is checked.
RUN python -m pip install ${DS60_PYTHON_INDEX_URL:+--index-url "$DS60_PYTHON_INDEX_URL"} --no-cache-dir \
    --require-hashes -r /tmp/bootstrap-pip.lock && rm /tmp/bootstrap-pip.lock \
    && install -d -m 0700 /run/ds60 && python -m venv --without-pip /opt/web
ENV PATH="/opt/web/bin:$PATH"
WORKDIR /opt/worker
ARG TARGETARCH
COPY docker/workers/requirements-python-web.${TARGETARCH}.lock /tmp/requirements.txt
RUN /usr/local/bin/python -m pip --python /opt/web/bin/python install ${DS60_PYTHON_INDEX_URL:+--index-url "$DS60_PYTHON_INDEX_URL"} --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/requirements.txt \
    && /usr/local/bin/python -m pip --python /opt/web/bin/python check && rm /tmp/requirements.txt \
    && /usr/local/bin/python -m pip uninstall --yes pip
COPY src/ds60sqlpy/__init__.py src/ds60sqlpy/http_server.py src/ds60sqlpy/module_worker.py src/ds60sqlpy/worker_operations.py src/ds60sqlpy/plot_artifacts.py src/ds60sqlpy/plot_capture.py src/ds60sqlpy/worker_figures.py /opt/worker/src/ds60sqlpy/
COPY courses/python-web/runtime_probe.py courses/python-web/runtime_extended_probe.py /opt/worker/courses/python-web/
ENV PYTHONPATH=/opt/worker/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 DS60_WORKER_PROFILE=python-web
ENTRYPOINT ["python", "-m", "ds60sqlpy.module_worker", "--host", "0.0.0.0", "--port", "8081"]
# Keep the revision last so a new commit reuses every earlier cached layer.
ARG DS60_SOURCE_REVISION=""
ARG DS60_RELEASE_VERSION=""
LABEL org.opencontainers.image.revision="${DS60_SOURCE_REVISION}" \
    org.opencontainers.image.version="${DS60_RELEASE_VERSION}" \
    org.opencontainers.image.source="https://github.com/sadatnfs/ds60sqlpy"
