// dax-032: Year-to-date means a specific included-date set
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-032-a: An early January anchor
// Context: Anchor 2025-01-03; classic Gregorian year; active OrderDate; coverage is available.
EVALUATE CALCULATETABLE ( ROW ( "CurrentDay", [NetRevenue], "YTD", CALCULATE ( [NetRevenue], DATESYTD ( 'Date'[Date] ) ) ), 'Date'[Date] = DATE ( 2025, 1, 3 ) )

// dax-032-b: An anchor in February
// Context: Anchor 2025-02-03; same calendar and date role.
EVALUATE CALCULATETABLE ( ROW ( "CurrentDay", [NetRevenue], "YTD", CALCULATE ( [NetRevenue], DATESYTD ( 'Date'[Date] ) ) ), 'Date'[Date] = DATE ( 2025, 2, 3 ) )
