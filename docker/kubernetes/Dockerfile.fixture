ARG DS60_PYTHON_IMAGE=python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
FROM ${DS60_PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Apply Debian security updates; the fixture never installs packages, so drop pip.
# hadolint ignore=DL3005
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall --yes pip
COPY docker/kubernetes/fixture.py /fixture.py
USER 65532:65532
ENTRYPOINT ["python", "/fixture.py"]
CMD ["server"]
