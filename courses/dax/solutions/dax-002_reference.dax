// dax-002: Grain, keys and why rows are not orders
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-002-a: Whole model counts
// Context: All Sales rows; one row per SaleID.
EVALUATE ROW ( "Lines", COUNTROWS ( Sales ), "Orders", DISTINCTCOUNT ( Sales[OrderID] ), "Revenue", [NetRevenue] )

// dax-002-b: One multi-line order
// Context: OrderID 101 only; both matching fact rows retained.
EVALUATE CALCULATETABLE ( ROW ( "Lines", COUNTROWS ( Sales ), "Orders", DISTINCTCOUNT ( Sales[OrderID] ), "Revenue", [NetRevenue] ), Sales[OrderID] = 101 )
