ARG DS60_PYTHON_IMAGE=python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
FROM ${DS60_PYTHON_IMAGE}
ARG TARGETARCH
ENV TARGETARCH=${TARGETARCH}
COPY docker/kubernetes/download_kubectl.py /tmp/download_kubectl.py
COPY requirements/kubernetes-worker.lock /tmp/kubernetes-worker.lock
COPY requirements/bootstrap-pip.lock /tmp/bootstrap-pip.lock
# Optional anonymous mirror for restricted networks; the install is hash-locked.
ARG DS60_PYTHON_INDEX_URL
# Apply Debian security updates newer than the pinned base image.
# hadolint ignore=DL3005
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && python -m pip install ${DS60_PYTHON_INDEX_URL:+--index-url "$DS60_PYTHON_INDEX_URL"} --no-cache-dir \
        --require-hashes -r /tmp/bootstrap-pip.lock && rm /tmp/bootstrap-pip.lock \
    && python /tmp/download_kubectl.py && rm /tmp/download_kubectl.py \
    && python -m pip install ${DS60_PYTHON_INDEX_URL:+--index-url "$DS60_PYTHON_INDEX_URL"} --no-cache-dir \
        --require-hashes -r /tmp/kubernetes-worker.lock && rm /tmp/kubernetes-worker.lock \
    && python -m pip uninstall --yes pip \
    && install -d -m 0700 /run/ds60
WORKDIR /opt/worker
COPY src/ds60sqlpy/__init__.py src/ds60sqlpy/http_server.py src/ds60sqlpy/module_worker.py src/ds60sqlpy/worker_operations.py src/ds60sqlpy/kubernetes_module.py /opt/worker/src/ds60sqlpy/
ENV PYTHONPATH=/opt/worker/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DS60_WORKER_PROFILE=k8s-kind
ENTRYPOINT ["python", "-m", "ds60sqlpy.kubernetes_module", "--host", "0.0.0.0", "--port", "8081"]
