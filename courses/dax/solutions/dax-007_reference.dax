// dax-007: Scalar types, operators and measurement units
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-007-a: A row of distinct types
// Context: Literal expressions; no model filter is needed.
EVALUATE ROW ( "Count", 3, "Ratio", DIVIDE ( 3, 2 ), "Larger", 3 > 2, "Day", DATE ( 2025, 1, 2 ) )

// dax-007-b: A number and its text label
// Context: All retail sales; a numeric result and an explicitly formatted text representation.
EVALUATE ROW ( "NumericRevenue", [NetRevenue], "DisplayText", FORMAT ( [NetRevenue], "$0.00", "en-US" ) )
