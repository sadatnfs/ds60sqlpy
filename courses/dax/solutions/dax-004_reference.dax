// dax-004: Relationships are filter rules, not materialized joins
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-004-a: Dimension-to-fact propagation
// Context: Blue Product rows; active Product -> Sales direction.
EVALUATE CALCULATETABLE ( ROW ( "VisibleProducts", COUNTROWS ( Product ), "Lines", COUNTROWS ( Sales ), "Revenue", [NetRevenue] ), Product[Color] = "Blue" )

// dax-004-b: Fact filter does not flow backward
// Context: Direct filter Sales.SaleID = S4; no Product filter; single-direction relationships.
EVALUATE CALCULATETABLE ( ROW ( "VisibleProducts", COUNTROWS ( Product ), "Lines", COUNTROWS ( Sales ), "Revenue", [NetRevenue] ), Sales[SaleID] = "S4" )
