# Local Docker course defaults. Copy to .env only when overriding them.
DS60_POSTGRES_PORT=55432
DS60_LAB_PORT=8765
DS60_COURSE_USER=admin
DS60_COURSE_PASSWORD=admin
DS60_LEARNING_DIR=./.learning
DS60_DOCKER_PROFILES=core
DS60_LAB_MEMORY=2g

# The host launcher creates the data folder and supplies the host UID/GID.
# Manual Compose users on macOS/Linux set these from id -u and id -g.
# DS60_UID=1000
# DS60_GID=1000
# DS60_ROOTLESS=0

# Optional trusted public-base alternative when Docker Hub's CDN is blocked:
# DS60_BASE_IMAGE=ghcr.io/astral-sh/uv:python3.12-bookworm-slim

# Explicit compatibility with an existing limited ds60 database volume:
# DS60_COURSE_USER=ds60
# DS60_COURSE_PASSWORD=ds60

# Host CLI/Jupyter target: export this in the HOST terminal when needed.
# It is not forwarded into the app container by Compose.
# DS60_DATABASE_URL=postgresql://admin:admin@localhost:55432/advanced_sql_training
# Advanced internal-container override, only for the same disposable local DB:
# DS60_LAB_DATABASE_URL=
