// dax-008: BLANK, zero and the difference between missing and false
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-008-a: Blank coercion is operator-specific
// Context: Literal BLANK operations; no model context.
EVALUATE ROW ( "LooseZero", BLANK() = 0, "StrictZero", BLANK() == 0, "PlusFive", BLANK() + 5, "TimesFive", BLANK() * 5 )

// dax-008-b: An existing product with no sales
// Context: ProductKey 4, Bag; no matching Sales rows.
EVALUATE CALCULATETABLE ( ROW ( "Products", COUNTROWS ( Product ), "SalesRows", COUNTROWS ( Sales ), "Revenue", [NetRevenue], "DisplayRevenue", COALESCE ( [NetRevenue], 0 ) ), Product[ProductKey] = 4 )
