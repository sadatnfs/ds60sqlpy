  "assumptions": [
    "Dates have no time component.",
    "All ordinary retail amounts are USD.",
    "The one side is unique; normal foreign keys are complete.",
    "Relationships are regular Import-style relationships for hand reasoning, not live engine metadata.",
    "The Date table contains 731 dates; guides show relevant slices rather than hide unselected dates.",
    "Budget, ForeignSales and ExchangeRate are disconnected; formulas explicitly transfer keys or look up a unique rate.",
    "Cohorts and experiments are independent synthetic populations, not renamed retail customers.",
    "Outcome data are complete for all four assignments; exposure is a separate event stream."
  ],
  "security_specification": {
    "status": "offline policy specification, not installed or tested security",
    "scope": "regular Import-style model; role-restricted Viewer context",
    "static_roles": {
      "NorthViewer": "Customer[Region] = \"North\"",
      "SouthViewer": "Customer[Region] = \"South\""
    },
    "dynamic_customer_rule": "Customer[Region] IN SELECTCOLUMNS(FILTER(Access, Access[Principal] = USERPRINCIPALNAME()), \"AllowedRegion\", Access[Region])",
    "unknown_principal": "no allowed Customer rows",
    "limits": [
      "Ordinary report filters are not security enforcement.",
      "Workspace Admin/Member/Contributor behavior must not be inferred from Viewer tests.",
      "The Access mapping itself requires appropriate visibility controls in a real model."
    ]
  }
