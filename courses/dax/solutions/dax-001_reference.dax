// dax-001: A semantic model, a question and a worked result
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-001-a: All eight lines
// Context: No filters; regular active relationships; USD sales-line grain.
EVALUATE ROW ( "NetRevenue", [NetRevenue] )

// dax-001-b: Notebook product only
// Context: ProductKey 1; the Product-to-Sales relationship is active and single-direction.
EVALUATE CALCULATETABLE ( ROW ( "NetRevenue", [NetRevenue] ), Product[ProductKey] = 1 )
