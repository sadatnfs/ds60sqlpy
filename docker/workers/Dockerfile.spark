ARG DS60_SPARK_IMAGE=spark:4.0.1-scala2.13-java17-python3-ubuntu@sha256:a552a335e0aedb44fa28b20ed7e9dc52c2e856faf87fb0409fb57dbf37b45bf7
ARG DS60_PYTHON_IMAGE=python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
FROM ${DS60_SPARK_IMAGE} AS spark
FROM ${DS60_PYTHON_IMAGE}
# Apply Debian security updates newer than the pinned base image.
# This image installs no Python packages, so pip is removed rather than upgraded.
# hadolint ignore=DL3005
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && python -m pip uninstall --yes pip
# Debian 13 has no OpenJDK 17 package; use the Temurin 17 JDK the Spark image ships.
COPY --from=spark /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk PATH="/opt/java/openjdk/bin:$PATH"
COPY --from=spark /opt/spark /opt/spark
# Drop the Hive, Spark Connect, Kubernetes, and ZooKeeper jars the classroom never loads
# and swap standalone dependency jars for SHA-256 pinned releases with security fixes.
COPY docker/workers/fetch_pinned.py docker/workers/spark/apply_jar_overrides.py docker/workers/spark/jar-overrides.json /tmp/spark-overrides/
RUN python /tmp/spark-overrides/apply_jar_overrides.py /opt/spark /tmp/spark-overrides/jar-overrides.json \
    && rm -rf /tmp/spark-overrides
# Learner jobs log Spark warnings and errors only (no INFO startup chatter).
COPY docker/workers/spark/log4j2.properties /opt/spark/conf/log4j2.properties
RUN install -d -m 0700 /run/ds60
WORKDIR /opt/worker
COPY src/ds60sqlpy/__init__.py src/ds60sqlpy/http_server.py src/ds60sqlpy/module_worker.py src/ds60sqlpy/worker_operations.py src/ds60sqlpy/plot_artifacts.py src/ds60sqlpy/plot_capture.py src/ds60sqlpy/worker_figures.py /opt/worker/src/ds60sqlpy/
COPY courses/scala-spark/fixtures/ /opt/worker/courses/scala-spark/fixtures/
ENV SPARK_HOME=/opt/spark PYTHONPATH=/opt/worker/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DS60_WORKER_PROFILE=scala-jvm SPARK_LOCAL_IP=127.0.0.1
ENTRYPOINT ["python", "-m", "ds60sqlpy.module_worker", "--host", "0.0.0.0", "--port", "8081"]
# Keep the revision last so a new commit reuses every earlier cached layer.
ARG DS60_SOURCE_REVISION=""
ARG DS60_RELEASE_VERSION=""
LABEL org.opencontainers.image.revision="${DS60_SOURCE_REVISION}" \
    org.opencontainers.image.version="${DS60_RELEASE_VERSION}" \
    org.opencontainers.image.source="https://github.com/sadatnfs/ds60sqlpy"
