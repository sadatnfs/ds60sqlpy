ARG DS60_PYTHON_IMAGE=python:3.12.12-slim-bookworm
FROM ${DS60_PYTHON_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN install -d -m 0700 /run/ds60
WORKDIR /opt/worker
ARG TARGETARCH
COPY docker/workers/requirements-tensorflow.${TARGETARCH}.lock /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/requirements.txt
COPY src/ds60sqlpy/__init__.py src/ds60sqlpy/module_worker.py src/ds60sqlpy/worker_operations.py /opt/worker/src/ds60sqlpy/
COPY courses/deep-learning-tensorflow/fixtures/ /opt/worker/courses/deep-learning-tensorflow/fixtures/
ENV PYTHONPATH=/opt/worker/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DS60_WORKER_PROFILE=tensorflow-cpu CUDA_VISIBLE_DEVICES=""
ENTRYPOINT ["python", "-m", "ds60sqlpy.module_worker", "--host", "0.0.0.0", "--port", "8081"]
