// dax-014: Filter context is the full question, not just one slicer
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-014-a: One region in one year
// Context: Customer.Region = North and Date.Year = 2025, using active OrderDate.
EVALUATE CALCULATETABLE ( ROW ( "Revenue", [NetRevenue] ), Customer[Region] = "North", 'Date'[Year] = 2025 )

// dax-014-b: A multi-selection retains the year
// Context: Region is the allowed set {North, South}; order year remains 2025.
EVALUATE CALCULATETABLE ( ROW ( "Revenue", [NetRevenue] ), Customer[Region] IN { "North", "South" }, 'Date'[Year] = 2025 )
