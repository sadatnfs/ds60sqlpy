{"cells":[{"cell_type":"markdown","metadata":{},"source":["# Day 42 — Unsupervised learning: KMeans & anomaly detection\n","Objectives:\n","- Cluster data with KMeans and interpret clusters.\n","- Evaluate with inertia/silhouette (caveats).\n","- Simple anomaly detection (IsolationForest/LocalOutlierFactor).\n"]},{"cell_type":"code","metadata":{},"execution_count":null,"outputs":[],"source":["from sklearn.datasets import make_blobs\n","from sklearn.cluster import KMeans\n","from sklearn.metrics import silhouette_score\n","import matplotlib.pyplot as plt\n","X, y_true = make_blobs(n_samples=600, centers=3, cluster_std=1.2, random_state=42)\n","km = KMeans(n_clusters=3, n_init='auto', random_state=42).fit(X)\n","sil = silhouette_score(X, km.labels_)\n","sil\n","plt.scatter(X[:,0], X[:,1], c=km.labels_, cmap='viridis', s=15)\n","plt.title('KMeans clusters'); plt.show()\n"]},{"cell_type":"code","metadata":{},"execution_count":null,"outputs":[],"source":["# Anomaly detection\n","from sklearn.ensemble import IsolationForest\n","iso = IsolationForest(contamination=0.02, random_state=42).fit(X)\n","scores = iso.decision_function(X)\n","pred = iso.predict(X)  # -1 outlier, 1 inlier\n","(pred==-1).mean()\n"]},{"cell_type":"markdown","metadata":{},"source":["## Exercises\n","1) Try different K and plot inertia vs K (elbow).\n","2) Compute silhouette for K in [2..6] and discuss.\n","3) Compare IsolationForest and LocalOutlierFactor."]}]}
