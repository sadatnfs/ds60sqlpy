{
  "apiVersion": "apiextensions.k8s.io/v1",
  "kind": "CustomResourceDefinition",
  "metadata": {
    "name": "lessonreports.learning.ds60sqlpy"
  },
  "spec": {
    "group": "learning.ds60sqlpy",
    "scope": "Namespaced",
    "names": {
      "plural": "lessonreports",
      "singular": "lessonreport",
      "kind": "LessonReport"
    },
    "versions": [
      {
        "name": "v1",
        "served": true,
        "storage": true,
        "subresources": {
          "status": {}
        },
        "schema": {
          "openAPIV3Schema": {
            "type": "object",
            "required": ["spec"],
            "properties": {
              "spec": {
                "type": "object",
                "required": ["message", "replicas"],
                "properties": {
                  "message": {
                    "type": "string",
                    "enum": ["hello", "reviewer"]
                  },
                  "replicas": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2
                  }
                }
              },
              "status": {
                "type": "object",
                "properties": {
                  "observedGeneration": {
                    "type": "integer"
                  },
                  "ready": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    ]
  }
}
