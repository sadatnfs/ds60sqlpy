// dax-022: Variables inside and outside an iterator
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-022-a: One shared total versus one value per product
// Context: No outer filters; four Product rows, including unsold Bag.
EVALUATE
VAR IncomingRevenue = [NetRevenue]
RETURN ROW ( "SharedScalarSum", SUMX ( Product, IncomingRevenue ), "PerProductSum", SUMX ( Product, VAR ProductRevenue = [NetRevenue] RETURN ProductRevenue ) )

// dax-022-b: An incoming filtered total is still shared
// Context: Paper is established before either variable binding; Product has two eligible rows.
EVALUATE CALCULATETABLE ( VAR IncomingRevenue = [NetRevenue] RETURN ROW ( "SharedScalarSum", SUMX ( Product, IncomingRevenue ), "PerProductSum", SUMX ( Product, VAR ProductRevenue = [NetRevenue] RETURN ProductRevenue ) ), Product[Category] = "Paper" )
