// dax-017: Explicit and implicit context transition
// Offline reference. These formulas have not been executed by this classroom.
// Model contract: courses/dax/models/retail/model.json
// Result cases and source/model hashes: courses/dax/reference-results.json

DEFINE
    MEASURE Sales[NetRevenue] = SUM ( Sales[NetAmount] )

// dax-017-a: Eight repetitions versus eight individual amounts
// Context: No outer filters; SUMX creates one Sales row context per unique SaleID.
EVALUATE ROW ( "RawRepeated", SUMX ( Sales, SUM ( Sales[NetAmount] ) ), "Transitioned", SUMX ( Sales, CALCULATE ( SUM ( Sales[NetAmount] ) ) ) )

// dax-017-b: Measure invocation transitions each customer
// Context: No outer filters; a model measure is invoked within each Customer row context.
EVALUATE ROW ( "CustomerRows", COUNTROWS ( Customer ), "SumOfCustomerRevenue", SUMX ( Customer, [NetRevenue] ) )
