# Local Docker course defaults. Copy to .env only when overriding them.
DS60_POSTGRES_PORT=55432
# Direct Compose defaults. ./classroom auto-selects host ports when these are unset.
DS60_LAB_PORT=8765
# Optional browser host-port override (0 means engine-selected):
# DS60_CLASSROOM_PORT=0
DS60_COURSE_USER=admin
DS60_COURSE_PASSWORD=admin
DS60_DOCKER_PROFILES=core
DS60_LAB_MEMORY=2g

# Learner data and private runtime state use project-scoped Docker named volumes.
# The classroom configures its container UID/GID; do not map these to host IDs.

# Optional trusted public-base alternative when Docker Hub's CDN is blocked:
# DS60_BASE_IMAGE=mirror.gcr.io/library/python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
# All ordinary worker build alternatives: docker/registry-mirrors.env.txt
# Use the documented build-only --env-file command; do not copy credentials here.

# The database is built locally from docker/postgres (Debian security updates and
# gosu rebuilt from source). To run another PostgreSQL image instead, which the
# launcher then pulls rather than builds:
# DS60_POSTGRES_IMAGE=registry.example/postgres:17-trixie@sha256:<digest>

# Explicit compatibility with an existing limited ds60 database volume:
# DS60_COURSE_USER=ds60
# DS60_COURSE_PASSWORD=ds60

# Host CLI/Jupyter target: export this in the HOST terminal when needed.
# It is not forwarded into the app container by Compose.
# DS60_DATABASE_URL=postgresql://admin:admin@localhost:55432/advanced_sql_training
# Advanced internal-container override, only for the same disposable local DB:
# DS60_LAB_DATABASE_URL=
