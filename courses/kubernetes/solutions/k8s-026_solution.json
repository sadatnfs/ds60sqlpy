{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "DaemonSet",
      "metadata": {
        "name": "node-fixture"
      },
      "spec": {
        "selector": {
          "matchLabels": {
            "app": "node-fixture"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "node-fixture"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 65532,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "hello",
                "image": "ds60sqlpy-k8s-fixture:0.2.0",
                "imagePullPolicy": "Never",
                "command": [
                  "python",
                  "/fixture.py",
                  "server"
                ],
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/ready",
                    "port": "http"
                  },
                  "periodSeconds": 2,
                  "failureThreshold": 2
                },
                "resources": {
                  "requests": {
                    "cpu": "10m",
                    "memory": "16Mi"
                  },
                  "limits": {
                    "cpu": "100m",
                    "memory": "64Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                }
              }
            ],
            "nodeSelector": {
              "lesson.ds60sqlpy/zone": "a"
            }
          }
        }
      }
    }
  ]
}
