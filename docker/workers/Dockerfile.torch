ARG DS60_PYTHON_IMAGE=python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
FROM ${DS60_PYTHON_IMAGE}
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN install -d -m 0700 /run/ds60
WORKDIR /opt/worker
ARG TARGETARCH
COPY docker/workers/requirements-torch.${TARGETARCH}.lock /tmp/requirements.txt
# CPU-only torch wheels come from the PyTorch index. With an optional anonymous
# mirror, every other locked package comes from the mirror and only the torch
# page is read from PyTorch; hashes are still required.
ARG DS60_PYTHON_INDEX_URL
RUN if [ -n "$DS60_PYTHON_INDEX_URL" ]; then \
      set -- --index-url "$DS60_PYTHON_INDEX_URL" --find-links https://download.pytorch.org/whl/cpu/torch/; \
    else \
      set -- --index-url https://download.pytorch.org/whl/cpu; \
    fi \
    && python -m pip install --no-cache-dir --require-hashes --only-binary=:all: "$@" -r /tmp/requirements.txt
COPY src/ds60sqlpy/__init__.py src/ds60sqlpy/http_server.py src/ds60sqlpy/module_worker.py src/ds60sqlpy/worker_operations.py src/ds60sqlpy/plot_artifacts.py src/ds60sqlpy/plot_capture.py src/ds60sqlpy/worker_figures.py /opt/worker/src/ds60sqlpy/
COPY courses/llm-theory/fixtures/ /opt/worker/courses/llm-theory/fixtures/
ENV PYTHONPATH=/opt/worker/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 DS60_WORKER_PROFILE=llm-torch-cpu CUDA_VISIBLE_DEVICES="" HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
ENTRYPOINT ["python", "-m", "ds60sqlpy.module_worker", "--host", "0.0.0.0", "--port", "8081"]
