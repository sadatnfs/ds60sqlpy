{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "gateway.networking.k8s.io/v1",
      "kind": "HTTPRoute",
      "metadata": {
        "name": "hello-route"
      },
      "spec": {
        "parentRefs": [
          {
            "name": "lesson-gateway"
          }
        ],
        "hostnames": [
          "lesson.local"
        ],
        "rules": [
          {
            "matches": [
              {
                "path": {
                  "type": "PathPrefix",
                  "value": "/version"
                }
              }
            ],
            "backendRefs": [
              {
                "name": "hello",
                "port": 8080
              }
            ]
          }
        ]
      }
    }
  ]
}
